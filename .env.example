# Copy to .env and fill in. .env is git-ignored — never commit real keys.
NEWS_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=th
SERPAPI_KEY=
SEARCH_QUERY=software engineer jobs Thailand

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

DB_PATH=./data/app.db
JOBS_AUTO_SEED=1
JOBS_AUTO_REFRESH=1
JOBS_REFRESH_HOURS=6

USE_SMALL_EMBEDDING=false
EMBEDDING_DEVICE=cpu
# LLM: Qwen2.5-7B-Instruct Q4_K_M by default (~4.7 GB, 16 GB RAM recommended).
# Override to any llama.cpp-compatible GGUF, e.g. 14B for stronger reasoning.
# LLM_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF
# LLM_FILE=qwen2.5-7b-instruct-q4_k_m.gguf
LLM_THREADS=4
LLM_CTX=8192
# Alternative provider: Google Gemini API (no local model/RAM needed).
# Google retires old Flash models regularly — unknown names 404 and the code
# auto-falls-through gemini-2.5-flash > 3.5-flash > 3.6-flash > 3.1-flash-lite.
# Check https://ai.google.dev/gemini-api/docs/models for the current list.
# LLM_PROVIDER=google
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Fetch diversity (tech + design + marketing + support…): 1 on, 0 off.
JOBS_DIVERSE=1
