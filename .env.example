# Copy to .env and fill in. .env is git-ignored — never commit real keys.
NEWS_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=th
SERPAPI_KEY=
SEARCH_QUERY=software engineer jobs Thailand

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

DB_PATH=./data/app.db
JOBS_AUTO_SEED=1
JOBS_AUTO_REFRESH=1
JOBS_REFRESH_HOURS=6

USE_SMALL_EMBEDDING=false
EMBEDDING_DEVICE=cpu
LLM_THREADS=4
LLM_CTX=4096
